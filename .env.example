# ==============================================================================
# AI-Powered Real-Time Financial Fraud Detection - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in appropriate values for local development.
# NEVER commit .env or real secrets to version control.
# ==============================================================================

# ---- Persistence backend ----
# "postgres" — default; production persistence (PostgreSQL / Supabase).
#              The backend fails fast at startup when the database is
#              unreachable (see docs/database-design.md).
# "sqlite"   — lightweight local development without a database server;
#              uses ALERT_DB_PATH / USER_DB_PATH below.
PERSISTENCE_BACKEND=postgres

# ---- PostgreSQL / Supabase ----
# Local development: `docker compose up -d` provides PostgreSQL at
# localhost:5432 using these variables.
# Supabase: set POSTGRES_HOST to the pooler host (e.g.
# "aws-0-eu-central-1.pooler.supabase.com"), POSTGRES_PORT=6543, and
# POSTGRES_SSL_MODE=require.  POSTGRES_USER is typically
# "postgres.<project-ref>" and POSTGRES_PASSWORD the database password.
# Credentials are never logged, never returned in API responses, and
# never committed to version control.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraud_detection
POSTGRES_USER=
POSTGRES_PASSWORD=
# TLS mode (libpq ``sslmode``).  Empty = library default ("prefer"),
# which works with the local docker-compose PostgreSQL.  Use "require"
# for Supabase or any managed PostgreSQL that enforces TLS.
POSTGRES_SSL_MODE=

# ---- Backend (FastAPI) ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# ---- Authentication (JWT) ----
# SECURITY: the default secret is for LOCAL DEVELOPMENT ONLY.
# Generate a strong secret for any other deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_SECRET_KEY=dev-insecure-secret-change-me-in-production
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Persistence (SQLite; only used when PERSISTENCE_BACKEND=sqlite) ----
ALERT_DB_PATH=data/alerts.db
USER_DB_PATH=data/users.db

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---- ML / Fraud Intelligence Service ----
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8001
ML_SERVICE_URL=http://localhost:8001
ML_MODEL_PATH=
ML_MODEL_VERSION=
ML_REQUEST_TIMEOUT_SECONDS=5
# The ML feature-history store stays on SQLite (single-process service;
# see ml/features/history.py).  Not used by the backend persistence layer.
ML_HISTORY_DB_PATH=data/ml_history.db

# ---- Risk Score Weights (used by ML/Fraud Intelligence Service) ----
ML_WEIGHT_ML=0.50
ML_WEIGHT_BEHAVIOUR=0.30
ML_WEIGHT_RULE=0.20

# ---- Risk Thresholds (used by ML/Fraud Intelligence Service) ----
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=70
# Scores 0–30 = LOW (APPROVE)
# Scores 31–70 = MEDIUM (VERIFY)
# Scores 71–100 = HIGH (HOLD + ALERT)

# ---- Logging ----
LOG_LEVEL=INFO

# ---- ML Monitoring / Observability (Step 43) ----
# Latency warning threshold (seconds).  Predictions slower than this
# increment the slow_predictions counter and log a warning.
ML_LATENCY_WARN_SECONDS=5.0
# Error rate warning threshold (fraction).  If failed/total exceeds
# this value, a warning is logged.
ML_ERROR_RATE_WARN_THRESHOLD=0.10
# Fraud rate warning threshold (fraction).  If fraud_count/successful
# exceeds this value, a warning is logged.
ML_FRAUD_RATE_WARN_THRESHOLD=0.50
# Drift detection: number of baseline standard deviations the recent
# mean must deviate to trigger a drift warning.
ML_DRIFT_STD_MULTIPLIER=3.0
#
# Optional baseline configuration for drift monitoring.
# If set, recent prediction distributions are compared against these
# baselines.  Leave unset to disable drift monitoring.
# ML_BASELINE_AMOUNT_MEAN=150.0
# ML_BASELINE_AMOUNT_STD=200.0
# ML_BASELINE_PROB_MEAN=0.15
# ML_BASELINE_PROB_STD=0.20
# ML_BASELINE_RISK_MEAN=30.0
# ML_BASELINE_RISK_STD=25.0

# ---- Development user seeding (python -m backend.db.seed_users) ----
# The seed tool honours PERSISTENCE_BACKEND.  When targeting the
# PostgreSQL backend, make sure POSTGRES_* are configured.  When
# targeting SQLite, set USER_DB_PATH instead.
# SEED_ANALYST_EMAIL=analyst@example.com
# SEED_ANALYST_PASS=
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASS=
