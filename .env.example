# ==============================================================================
# AI-Powered Real-Time Financial Fraud Detection - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in appropriate values for local development.
# NEVER commit .env or real secrets to version control.
# ==============================================================================

# ---- Persistence backend ----
# "postgres" — default; production persistence (PostgreSQL / Supabase).
#              The backend fails fast at startup when the database is
#              unreachable (see docs/database-design.md).
# "sqlite"   — lightweight local development without a database server;
#              uses ALERT_DB_PATH / USER_DB_PATH below.
PERSISTENCE_BACKEND=postgres

# ---- PostgreSQL / Supabase ----
# Local development: `docker compose up -d` provides PostgreSQL at
# localhost:5432 using these variables.
# For Supabase: use the connection details from Dashboard > Settings > Database.
#   POSTGRES_HOST  = Supabase pooler host (e.g. aws-0-eu-central-1.pooler.supabase.com)
#   POSTGRES_PORT  = 5432 (direct) or 6543 (pooler)
#   POSTGRES_DB    = postgres
#   POSTGRES_USER  = postgres.[project-ref]  (direct) or postgres.[project-ref] (pooler)
#   POSTGRES_PASSWORD = your database password
# Credentials are never logged, never returned in API responses, and
# never committed to version control.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraud_detection
POSTGRES_USER=
POSTGRES_PASSWORD=
# TLS mode (libpq ``sslmode``).  Empty = library default ("prefer"),
# which works with the local docker-compose PostgreSQL.  Use "require"
# for Supabase or any managed PostgreSQL that enforces TLS.
POSTGRES_SSL_MODE=prefer

# ---- Backend (FastAPI) ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# ---- Authentication (JWT) ----
# SECURITY: the default secret is for LOCAL DEVELOPMENT ONLY.
# Generate a strong secret for any other deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_SECRET_KEY=dev-insecure-secret-change-me-in-production
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Persistence (SQLite; only used when PERSISTENCE_BACKEND=sqlite) ----
ALERT_DB_PATH=data/alerts.db
USER_DB_PATH=data/users.db

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---- ML / Fraud Intelligence Service ----
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8001
ML_SERVICE_URL=http://localhost:8001
ML_MODEL_PATH=
ML_MODEL_DIR=
ML_MODEL_VERSION=
ML_REQUEST_TIMEOUT_SECONDS=5
# The ML feature-history store stays on SQLite (single-process service;
# see ml/features/history.py).  Not used by the backend persistence layer.
ML_HISTORY_DB_PATH=data/ml_history.db
#
# Step 46 — Model Governance:
# ML_MODEL_DIR overrides the directory containing the model artifact and
# model_manifest.json (default: ml/models/).  When set, the ML service
# loads the model through integrity verification (SHA-256 checksum against
# the manifest) before activation.  Artifacts must originate from a trusted
# build/training pipeline (joblib uses pickle, which can execute code).
# ML_MODEL_DIR is server configuration only — clients can never control
# model selection or artifact paths.

# ---- Risk Score Weights (used by ML/Fraud Intelligence Service) ----
ML_WEIGHT_ML=0.50
ML_WEIGHT_BEHAVIOUR=0.30
ML_WEIGHT_RULE=0.20

# ---- Risk Thresholds (used by ML/Fraud Intelligence Service) ----
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=70
# Scores 0–30 = LOW (APPROVE)
# Scores 31–70 = MEDIUM (VERIFY)
# Scores 71–100 = HIGH (HOLD + ALERT)

# ---- Logging ----
LOG_LEVEL=INFO

# ---- ML Monitoring / Observability (Step 43) ----
# Latency warning threshold (seconds).  Predictions slower than this
# increment the slow_predictions counter and log a warning.
ML_LATENCY_WARN_SECONDS=5.0
# Error rate warning threshold (fraction).  If failed/total exceeds
# this value, a warning is logged.
ML_ERROR_RATE_WARN_THRESHOLD=0.10
# Fraud rate warning threshold (fraction).  If fraud_count/successful
# exceeds this value, a warning is logged.
ML_FRAUD_RATE_WARN_THRESHOLD=0.50
# Drift detection: number of baseline standard deviations the recent
# mean must deviate to trigger a drift warning.
ML_DRIFT_STD_MULTIPLIER=3.0
#
# Optional baseline configuration for drift monitoring.
# If set, recent prediction distributions are compared against these
# baselines.  Leave unset to disable drift monitoring.
# ML_BASELINE_AMOUNT_MEAN=150.0
# ML_BASELINE_AMOUNT_STD=200.0
# ML_BASELINE_PROB_MEAN=0.15
# ML_BASELINE_PROB_STD=0.20
# ML_BASELINE_RISK_MEAN=30.0
# ML_BASELINE_RISK_STD=25.0

# ---- Offline Model Evaluation (Step 47) ----
# EVAL_* variables configure OFFLINE evaluation only.  They NEVER
# affect live inference, the production decision threshold (bundled
# with the model artifact), or risk aggregation.  Evaluation
# recommendations are labelled "EVALUATION / RECOMMENDATION ONLY"
# and are never applied automatically.
#
# Threshold sweep grid (inclusive stop; sweep bounded to <= 201 points).
EVAL_THRESHOLD_START=0.05
EVAL_THRESHOLD_STOP=0.95
EVAL_THRESHOLD_STEP=0.05
# Optional business-cost model for cost-based threshold analysis:
#   total_cost = FN * EVAL_FN_COST + FP * EVAL_FP_COST
# Leave unset to disable cost analysis (it is then honestly reported
# as unavailable instead of using hard-coded defaults).
# EVAL_FN_COST=150.0
# EVAL_FP_COST=2.0
# Optional recommendation constraints (fractions in [0, 1]).
# min_recall:  maximise precision subject to recall >= EVAL_MIN_RECALL.
# min_precision: maximise recall subject to precision >= EVAL_MIN_PRECISION.
# Leave unset to disable the corresponding strategy.
# EVAL_MIN_RECALL=0.80
# EVAL_MIN_PRECISION=
# Number of reliability-diagram bins (2-50; bounded output).
EVAL_CALIBRATION_BINS=10

# ---- Automated Model Promotion Gate (Step 48) ----
# PROMO_* variables configure the OFFLINE promotion gate that compares a
# candidate model against the current production model and answers
# APPROVED or REJECTED.  The gate NEVER activates a model automatically,
# NEVER modifies the production manifest, and NEVER changes the
# production decision threshold — promotion remains an explicit operator
# action through the Step 46 governance workflow.
#
# Absolute minimum requirements (fractions in [0, 1]; unset = default;
# 'none' or 'off' disables the gate; out-of-range values fail closed).
# PROMO_MIN_PR_AUC=0.10
# PROMO_MIN_ROC_AUC=0.75
# PROMO_MIN_RECALL=0.70
# PROMO_MIN_PRECISION=0.05
# PROMO_MIN_F1=0.10
# PROMO_MAX_BRIER=0.25
#
# Relative regression limits vs production (fractions in [0, 1]).
# 0.10 means the candidate may degrade at most 10 % relative to the
# production value for that metric.  0.0 forbids any degradation.
# PROMO_MAX_PR_AUC_DEGRADATION=0.05
# PROMO_MAX_ROC_AUC_DEGRADATION=0.02
# PROMO_MAX_RECALL_DEGRADATION=0.10
# PROMO_MAX_PRECISION_DEGRADATION=0.10
# PROMO_MAX_F1_DEGRADATION=0.10
# PROMO_MAX_BRIER_INCREASE=0.10
#
# CLI: python -m ml.evaluation.promotion_gate --candidate-model-dir <dir> [--output PATH]
# Exit codes: 0 approved, 1 rejected, 2 internal error.

# ---- Promotion History & Audit Trail (Step 49) ----
# PROMO_HISTORY_DIR configures where promotion gate decisions are
# persisted for audit and traceability.  Each decision is saved as a
# bounded JSON file.  History is append-only and never modifies
# production state.
#
# Set to 'none' or 'off' to disable history persistence.
# Default: ml/promotion_history/
# PROMO_HISTORY_DIR=ml/promotion_history
#
# CLI: python -m ml.evaluation.promotion_history [--history-dir DIR] [--decision APPROVED|REJECTED] [--limit N] [--summary]

# ---- Development user seeding (python -m backend.db.seed_users) ----
# The seed tool honours PERSISTENCE_BACKEND.  When targeting the
# PostgreSQL backend, make sure POSTGRES_* are configured.  When
# targeting SQLite, set USER_DB_PATH instead.
# SEED_ANALYST_EMAIL=analyst@example.com
# SEED_ANALYST_PASS=
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASS=
