# ==============================================================================
# AI-Powered Real-Time Financial Fraud Detection - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in appropriate values for local development.
# NEVER commit .env or real secrets to version control.
# ==============================================================================

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraud_detection
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---- Backend (FastAPI) ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_SECRET_KEY=
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_CORS_ORIGINS=http://localhost:5173

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---- ML Service ----
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8001

# ---- Risk Thresholds (configurable) ----
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=70
# Scores above RISK_THRESHOLD_MEDIUM are HIGH

# ---- Logging ----
LOG_LEVEL=INFO
